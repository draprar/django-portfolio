# Core Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Leave empty for local SQLite. Set a URL to use that database instead.
DATABASE_URL=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production: walery.onrender.com (portfolio /) and jedzien.pl (hub)
JEDZIEN_REDIRECT_HOSTS=jedzien.pl,www.jedzien.pl
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_ADMIN_URL=admin
# Optional comma-separated regex list for rare proxy redirect exemptions.
DJANGO_SECURE_REDIRECT_EXEMPT=

# Optional services
SENTRY_DSN=
REDIS_URL=

# Email / contact
DEFAULT_FROM_EMAIL=webmaster@localhost
BREVO_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Storage backend
# Local media by default. Set USE_S3=True only with complete S3/Supabase config.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
SUPABASE_PROJECT_REF=
AWS_S3_REGION_NAME=

# Cloudflare R2 — required for bies when USE_S3=True (startup fails if any are empty).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# DocDiff — uncompressed payload cap (MB). Upload cap stays 10 MB.
DOCDIFF_MAX_UNCOMPRESSED_MB=50

# Testing
DJANGO_TESTING=False

